{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>sksat/renovate-config"
  ],
  "additionalReviewers": [
    "sksat"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# depName=(?<depName>.*?) datasource=(?<datasource>.*)\nARG .*_VERSION=\"(?<currentValue>.*)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "# depName=(?<depName>.*?) packageName=(?<packageName>.*?) datasource=(?<datasource>.*)\n\\s*\"(?<currentValue>[^\"]*)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}",
      "autoReplaceStringTemplate": "# depName={{{depName}}} packageName={{{packageName}}} datasource={{{datasource}}}\n    \"{{{newValue}}}\",\n    \"{{{currentValue}}}\""
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "# depName=(?<depName>.*?) packageName=(?<packageName>.*?) datasource=(?<datasource>.*)\nvariable \"[A-Z_]+\" \\{\n\\s*default = \"(?<currentValue>[^\"]*)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
    }
  ]
}
